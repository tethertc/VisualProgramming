<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.studentcard.HelloController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Заголовок -->
    <Label text="КАРТОЧКА СТУДЕНТА" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- GridPane с полями -->
    <GridPane hgap="10" vgap="10">
        <!-- Строка 0: Имя -->
        <Label text="Имя:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtName" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <!-- Строка 1: Фамилия -->
        <Label text="Фамилия:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtSurname" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Строка 2: Возраст -->
        <Label text="Возраст:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtAge" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <!-- Строка 3: Специальность -->
        <Label text="Специальность:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtSpeciality" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <!-- Строка 4: Курс -->
        <Label text="Курс:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbCourse" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <!-- Строка 5: Город (самостоятельная часть) -->
        <Label text="Город:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbCity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <!-- Строка 6: Форма обучения (самостоятельная часть) -->
        <Label text="Форма обучения:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <HBox spacing="10" GridPane.rowIndex="6" GridPane.columnIndex="1">
            <RadioButton fx:id="rbFullTime" text="Очная"/>
            <RadioButton fx:id="rbDistance" text="Дистанционная"/>
        </HBox>

        <!-- Строка 7: Общежитие (самостоятельная часть) -->
        <Label text="Общежитие:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <CheckBox fx:id="chkDormitory" text="Проживает в общежитии"
                  GridPane.rowIndex="7" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- HBox с кнопками -->
    <HBox spacing="15">
        <Button fx:id="btnCreate" text="Сформировать" onAction="#onCreateClick"/>
        <Button fx:id="btnClear" text="Очистить" onAction="#onClearClick"/>
        <Button fx:id="btnExit" text="Выход" onAction="#onExitClick"/>
    </HBox>

    <!-- Результат -->
    <Label fx:id="lblResult" wrapText="true" style="-fx-font-size: 14px;"/>
</VBox>